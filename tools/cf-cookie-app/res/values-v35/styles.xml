<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 (API 35) forza l'edge-to-edge: qui lo disattiviamo, cosi
         header e pulsanti non finiscono sotto la status bar. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">#FF0F1318</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
